rules_version = '2';
// Reglas de Firestore para RM Perfiles — pegar en Firebase Console › Firestore › Reglas.
// Si cambian los emails de super admin (js/permisos-service.js), cambiarlos también aquí y volver a Publicar.
// Perfil de cada usuario en usuarios/{email en minúsculas}: { activo, tabs: { registro|jugadores|plantillas|sucesion|config: 'oculta'|'ver'|'editar' } }
service cloud.firestore {
  match /databases/{database}/documents {

    function email() { return request.auth.token.email.lower(); }
    // Cuenta con la que entran las funciones de Vercel (api/mfa.js, api/red.js). Igual que SERVIDOR_EMAIL en api/_firebase.js.
    function servidor() { return request.auth != null && request.auth.token.email == 'servidor@fichasur-f9d61.firebaseapp.com'; }
    // Lo que el servidor apunta de cada sesión: authTime (código de la doble verificación acertado) y redHasta (red del club).
    function sesionPath() { return /databases/$(database)/documents/sesiones/$(email()); }
    function sesion() { return exists(sesionPath()) ? get(sesionPath()).data : {}; }
    // Sesión iniciada con contraseña + código de la app autenticadora: solo vale para la sesión en la que se puso
    // el código (mismo auth_time; un login nuevo vuelve a pedirlo). Ver SEGURIDAD.md.
    function dobleFactor() { return request.auth != null && request.auth.token.email != null && sesion().get('authTime', 0) == request.auth.token.auth_time; }
    function esSuper() { return dobleFactor() && email() in ['pablo.vegamartin@gmail.com', 'pvega@realmadrid.es']; }
    function perfilPath() { return /databases/$(database)/documents/usuarios/$(email()); }
    function tienePerfil() { return dobleFactor() && request.auth.token.email != null && exists(perfilPath()); }
    function perfil() { return get(perfilPath()).data; }
    // Horario de acceso del perfil { dias: [1..7] (1 = lunes), desde, hasta } en minutos, hora de Madrid.
    // Las reglas no conocen el cambio de hora: se acepta si encaja con UTC+1 o con UTC+2 (margen de 1 h en los bordes).
    function enFranja(h, offset) {
      let t = request.time + duration.value(offset, 'm');
      let m = t.hours() * 60 + t.minutes();
      return t.dayOfWeek() in h.dias && m >= h.desde && m < h.hasta;
    }
    function horarioOk() { let h = perfil().get('horario', null); return h == null || enFranja(h, 60) || enFranja(h, 120); }
    // "Solo red del club": api/red.js marca la sesión (redHasta) cuando se conecta desde una red registrada.
    function redOk() { return perfil().get('exigeRed', false) != true || sesion().get('redHasta', 0) > request.time.toMillis(); }
    function activo() { return esSuper() || (tienePerfil() && perfil().get('activo', true) == true && horarioOk() && redOk()); }
    function edita(tab) { return esSuper() || (activo() && perfil().get('tabs', {}).get(tab, 'oculta') == 'editar'); }

    // Gestión de usuarios: solo el super admin. Cada uno puede leer su propio perfil
    // y apuntar en él que ha aceptado el aviso de privacidad (nada más).
    match /usuarios/{id} {
      allow read: if esSuper() || (dobleFactor() && request.auth.token.email != null && id == email());
      allow write: if esSuper();
      allow update: if dobleFactor() && request.auth.token.email != null && id == email()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['privacidadAceptada', 'updatedAt']);
    }

    // Claves de la doble verificación: solo las usa el servidor (api/mfa.js); nadie las lee desde el navegador.
    match /mfa/{id} {
      allow read, write: if servidor();
    }
    // Marcas de sesión (doble verificación y red del club): las escribe solo el servidor; cada uno lee la suya.
    match /sesiones/{id} {
      allow read: if servidor() || (request.auth != null && request.auth.token.email != null && id == email());
      allow write: if servidor();
    }

    // Redes del club (IPs desde las que pueden entrar los usuarios con "Solo red del club"). Las añade api/red.js.
    match /redes/{id} {
      allow read, write: if esSuper() || servidor();
    }

    // Registro de actividad: cada uno solo puede AÑADIR entradas a su nombre; solo el super admin las lee;
    // nadie puede modificarlas ni borrarlas.
    match /auditoria/{id} {
      allow create: if request.auth != null && request.auth.token.email != null
        && request.resource.data.email == email()
        && request.resource.data.keys().hasOnly(['email', 'accion', 'detalle', 'fecha']);
      allow read: if esSuper();
      allow update, delete: if false;
    }

    match /config/{id} {
      allow read: if activo();
      allow write: if edita('config');
    }
    match /evaluaciones/{id} {
      allow read: if activo();
      allow write: if edita('registro');
    }
    match /registros/{id} {
      allow read: if activo();
      allow write: if edita('registro');
    }
    // Jugadores y plantillas se modifican desde Registro (importar), Jugadores y Plantillas.
    match /jugadores/{id} {
      allow read: if activo();
      allow write: if edita('registro') || edita('jugadores') || edita('plantillas');
      match /historico/{h} {
        allow read: if activo();
        allow write: if edita('registro') || edita('jugadores') || edita('plantillas');
      }
    }
    match /plantillas/{id} {
      allow read: if activo();
      allow write: if edita('registro') || edita('jugadores') || edita('plantillas');
    }
  }
}
